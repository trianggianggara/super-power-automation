# ==============================================================================
# Auto-Register Account Platform - Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# Browser & Headless Settings
# Path ke executable browser jika menggunakan custom binary (Chrome / Brave / Camoufox / Cloakbrowser)
# Jika dikosongkan, script akan otomatis mendeteksi Google Chrome atau Chromium di sistem.
BROWSER_EXECUTABLE_PATH=
HEADLESS=true

# Koneksi & Proxy
# Format: http://user:pass@host:port atau socks5://user:pass@host:port
PROXY=
DISABLE_PROXY=false
PROXY_MAX_LATENCY_MS=3000
PROXY_CHECK_CONCURRENCY=150

# LLM Vision Captcha Solver (Opsional: untuk slider & visual puzzle captcha)
LLM_API_KEY=your_llm_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Microsoft Graph API / Outlook Integration
# Digunakan untuk auto-read inbox Outlook/Hotmail guna mengambil OTP & link aktivasi
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_ENABLE_RECOVERY_EMAIL=true

# Gmail API OAuth2 (Opsional: jika menggunakan mode Gmail dot-trick)
GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# TempMail Service (Opsional)
TEMPMAIL_PROVIDER=webhook
TEMPMAIL_WEBHOOK_API_URL=http://127.0.0.1:8787
TEMPMAIL_WEBHOOK_SECRET=your_secret_here

# Default Passwords for Registrars
PASSWORD=YourStrongPassword2026!
